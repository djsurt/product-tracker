# Copy to .env and adjust as needed. .env is gitignored.

# --- Database ---
POSTGRES_USER=deals
POSTGRES_PASSWORD=deals
POSTGRES_DB=deals
# Hostname is the docker-compose service name when running in compose.
DATABASE_URL=postgresql+psycopg://deals:deals@postgres:5432/deals

# --- Redis (cache + Celery broker) ---
REDIS_URL=redis://redis:6379/0

# --- Pipeline (Phase 2) ---
# In docker-compose this is overridden to http://mock-store:9000.
MOCK_STORE_URL=http://localhost:9000
REFRESH_INTERVAL_SECONDS=30

# --- Real sources (Phase 3) — leave blank to keep them disabled ---
# eBay: register an app at https://developer.ebay.com (Browse API).
EBAY_ENV=production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Best Buy: get a key at https://developer.bestbuy.com (Products API).
BESTBUY_API_KEY=

# --- Reliability + caching (Phase 3) ---
SOURCE_RATE_LIMIT_PER_SEC=5
BEST_DEAL_CACHE_TTL_SECONDS=60
PRICE_HISTORY_WINDOW_DAYS=30

# --- Auth ---
# Generate a real secret for anything non-local, e.g.:  openssl rand -hex 32
JWT_SECRET=dev-insecure-change-me-0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- App ---
ENV=local
LOG_LEVEL=info
