# Copy to .env and adjust as needed. .env is gitignored.

# --- Database ---
POSTGRES_USER=deals
POSTGRES_PASSWORD=deals
POSTGRES_DB=deals
# Hostname is the docker-compose service name when running in compose.
DATABASE_URL=postgresql+psycopg://deals:deals@postgres:5432/deals

# --- Redis (cache + Celery broker) ---
REDIS_URL=redis://redis:6379/0

# --- Pipeline (Phase 2) ---
# In docker-compose this is overridden to http://mock-store:9000.
MOCK_STORE_URL=http://localhost:9000
REFRESH_INTERVAL_SECONDS=30

# --- Real sources (Phase 3) — leave blank to keep them disabled ---
# eBay: register an app at https://developer.ebay.com (Browse API).
EBAY_ENV=production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Best Buy: get a key at https://developer.bestbuy.com (Products API).
# (Note: Best Buy currently rejects free-email/.edu signups.)
BESTBUY_API_KEY=

# RapidAPI "Real-Time Product Search" — Gmail-friendly. Subscribe at
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/real-time-product-search
RAPIDAPI_KEY=

# --- Scraper (Phase 5) — set true to add the HTML-scraping source ---
# Defaults to scraping our own mock store's /html pages; override the base URL
# to point it elsewhere.
SCRAPER_ENABLED=false
SCRAPER_BASE_URL=

# Personal-use marketplace scrapers. These do not use official APIs and are
# best-effort HTML parsers; keep rate limits low and disable if a site blocks or
# changes markup.
EBAY_SCRAPER_ENABLED=true
EBAY_SCRAPER_BASE_URL=https://www.ebay.com
SHEIN_SCRAPER_ENABLED=true
SHEIN_SCRAPER_BASE_URL=https://us.shein.com

# --- Reliability + caching (Phase 3) ---
SOURCE_RATE_LIMIT_PER_SEC=5
BEST_DEAL_CACHE_TTL_SECONDS=60
PRICE_HISTORY_WINDOW_DAYS=30

# --- Notifications + redirect (Phase 4) ---
# Defaults target MailHog (a dev SMTP catcher). In compose SMTP_HOST is
# overridden to "mailhog"; locally without compose, run MailHog on these ports.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=Deal Hunter <deals@dealhunter.local>
# Base URL used to build the /go/{offer_id} link inside alert emails.
APP_BASE_URL=http://localhost:8000
# Cooldown (seconds) before the same alert can fire again — anti-spam.
ALERT_DEBOUNCE_SECONDS=3600

# --- Auth ---
# Generate a real secret for anything non-local, e.g.:  openssl rand -hex 32
JWT_SECRET=dev-insecure-change-me-0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- App ---
ENV=local
LOG_LEVEL=info
